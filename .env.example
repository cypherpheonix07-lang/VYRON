# Environment variables for STARK Event Agent / Project Brahma
# Required Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LLM Gateway Server-Side Credentials (NEVER exposed to frontend bundle)
# Used by Supabase Edge Functions: llm-gateway & embed
OPENROUTER_API_KEY=
HF_TOKEN=

# Offline / Resilience Drill Flag (forces deterministic template engine)
VITE_FORCE_TEMPLATE=false

# Feature & Debug Flags
VITE_DEMO_MODE=false
VITE_DEBUG_SESSION=false

# Application URL (used for auth redirects)
VITE_APP_URL=http://localhost:8080

# Optional OAuth provider toggles
VITE_OAUTH_GOOGLE=true
VITE_OAUTH_GITHUB=true
VITE_OAUTH_GITLAB=false
